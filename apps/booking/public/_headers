/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'
/
  Content-Security-Policy: frame-ancestors 'none'
/studio
  Content-Security-Policy: frame-ancestors 'none'
/studio/*
  Content-Security-Policy: frame-ancestors 'none'
/index.html
  Content-Security-Policy: frame-ancestors 'none'
/device
  Content-Security-Policy: frame-ancestors 'none'
/manage/*
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'
